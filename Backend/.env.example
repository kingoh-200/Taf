# ===== Server =====
PORT=3001

# ===== PostgreSQL Database =====
# Local development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=club_website
DB_USER=postgres
DB_PASSWORD=change_me

# Production (Supabase) — REPLACE with your real connection string in Render env vars.
# NEVER commit real credentials to this file.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# ===== JWT =====
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ===== CORS =====
# Comma-separated list of allowed frontend origins (e.g. https://your-app.vercel.app)
FRONTEND_URL=http://localhost:5173

# ===== Email (SMTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=Teens Aloud Foundation <youremail@gmail.com>

# ===== Frontend (Vercel / Vite) =====
# Cloudinary uploads (unsigned preset — safe to be public)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset